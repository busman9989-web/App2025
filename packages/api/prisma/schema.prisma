generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String   @id @default(uuid()) @map("id")
  email                String   @unique
  passwordHash         String   @map("password_hash")
  role                 String   @default("user")
  createdAt            DateTime @default(now()) @map("created_at")
  isVerified           Boolean  @default(false) @map("is_verified")
  verificationToken    String?  @map("verification_token")
  twoFaSecret          String?  @map("two_fa_secret")
  twoFaEnabled         Boolean  @default(false) @map("two_fa_enabled")
  displayNameEncrypted String?  @map("display_name_encrypted")
  statusEncrypted      String?  @map("status_encrypted")
  profilePictureUrl    String?  @map("profile_picture_url")
  bioEncrypted         String?  @map("bio_encrypted") // NEW
  emailNotifications   Boolean? @default(true) @map("email_notifications")
  appNotifications     Boolean? @default(true) @map("app_notifications")

  posts           Post[]
  postVotes       PostVote[]
  appointments    Appointment[]
  comments        Comment[]
  journalEntries  JournalEntry[]
  checklists      Checklist[]
  reports         Report[]
  resourceReviews ResourceReview[]
  dailyStatuses   DailyStatus[]
  votes           Vote[]
  plannerEvents   PlannerEvent[]

  chatThreadParticipants ChatThreadParticipant[]
  chatMessages           ChatMessage[]

  requestedFriends Friendship[] @relation("RequestedFriends")
  receivedFriends  Friendship[] @relation("ReceivedFriends")

  @@map("users")
}

model Post {
  id          String  @id @default(uuid())
  userId      String  @map("user_id")
  isAnonymous Boolean @default(false) @map("is_anonymous")
  title       String?
  content     String
  category    String
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postVotes   PostVote[]
  comments    Comment[]
  votes       Vote[]

  @@map("posts")
}

model PostVote {
  userId   String @map("user_id")
  postId   String @map("post_id")
  voteType Int    @map("vote_type")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@map("post_votes")
}

model Appointment {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  title               String
  description         String?
  appointmentDatetime DateTime @map("appointment_datetime")
  location            String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Comment {
  id             String        @id @default(uuid())
  postId         String?       @map("post_id")
  journalEntryId String?       @map("journal_entry_id")
  userId         String        @map("user_id")
  title          String?
  content        String
  createdAt      DateTime      @default(now()) @map("created_at")
  parentId       String?       @map("parent_id")
  parent         Comment?      @relation("ReplyToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[]     @relation("ReplyToComment")
  votes          Vote[]
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model JournalEntry {
  id                 String    @id @default(uuid())
  userId             String    @map("user_id")
  entryDate          DateTime  @map("entry_date") @db.Date
  moodRating         Int?      @map("mood_rating")
  entryTextEncrypted String    @map("entry_text_encrypted")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments           Comment[]
  votes              Vote[]

  @@unique([userId, entryDate])
  @@map("journal_entries")
}

model Resource {
  id          String   @id @default(uuid())
  title       String
  content     String?  @db.Text
  category    String?
  externalUrl String?  @map("external_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  reviews     ResourceReview[]
  votes       Vote[]

  @@map("resources")
}

model ResourceReview {
  id         String   @id @default(uuid())
  rating     Int
  content    String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  resourceId String   @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes      Vote[]

  @@unique([resourceId, userId])
  @@map("resource_reviews")
}

model Vote {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  voteType  Int      @map("vote_type")
  createdAt DateTime @default(now()) @map("created_at")

  postId          String?
  post            Post?          @relation(fields: [postId], references: [id], onDelete: Cascade)
  journalEntryId  String?        @map("journal_entry_id")
  journalEntry    JournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  resourceReviewId String?       @map("resource_review_id")
  resourceReview   ResourceReview? @relation(fields: [resourceReviewId], references: [id], onDelete: Cascade)
  commentId       String?        @map("comment_id")
  comment         Comment?       @relation(fields: [commentId], references: [id], onDelete: Cascade)
  resourceId      String?        @map("resource_id")
  resource        Resource?      @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId], name: "UserPostVote")
  @@unique([userId, journalEntryId], name: "UserJournalEntryVote")
  @@unique([userId, resourceReviewId], name: "UserResourceReviewVote")
  @@unique([userId, commentId], name: "UserCommentVote")
  @@unique([userId, resourceId], name: "UserResourceVote")
  @@map("votes")
}

model Checklist {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  items      Json     @default("[]")
  isTemplate Boolean  @default(false) @map("is_template")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("checklists")
}

model DailyStatus {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  statusDate DateTime @map("status_date") @db.Date
  statusText String   @map("status_text")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, statusDate])
  @@map("daily_statuses")
}

model PlannerEvent {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  start       DateTime
  end         DateTime?
  isAllDay    Boolean  @default(false) @map("is_all_day")
  location    String?
  category    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("planner_events")
}

model Report {
  id         String   @id @default(uuid())
  reporterId String   @map("reporter_id")
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  reason     String
  status     String   @default("pending")
  createdAt  DateTime @default(now()) @map("created_at")
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model ChatThread {
  id            String   @id @default(uuid())
  name          String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")
  participants  ChatThreadParticipant[]
  messages      ChatMessage[]

  @@map("chat_threads")
}

model ChatThreadParticipant {
  id        String     @id @default(uuid())
  userId    String     @map("user_id")
  threadId  String     @map("thread_id")
  joinedAt  DateTime   @default(now()) @map("joined_at")
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@map("chat_thread_participants")
}

model ChatMessage {
  id        String     @id @default(uuid())
  threadId  String     @map("thread_id")
  senderId  String     @map("sender_id")
  text      String
  createdAt DateTime   @default(now()) @map("created_at")
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Friendship {
  id           String   @id @default(uuid())
  requesterId  String   @map("requester_id")
  addresseeId  String   @map("addressee_id")
  status       String   @default("pending")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  requester User @relation("RequestedFriends", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ReceivedFriends", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}